# Forward local .home.arpa DHCP hostnames to dnsmasq on port 5353
# server 127.0.0.1:5353 -group local_lan -exclude-default-group
# domain-rules /home.arpa/ -nameserver local_lan

# Load Ad-Blocking Blocklists via domain-set
{% for bl in smartdns_blocklists %}
domain-set -name {{ bl.name }} -file /etc/smartdns/blocklists/{{ bl.name }}.conf
domain-rules /domain-set:{{ bl.name }}/ -address #
{% endfor %}
