# ==========================================
# WireGuard Interface, Peers & Firewall
# ==========================================
delete network.wg0

set network.wg0=interface
set network.wg0.proto='wireguard'
set network.wg0.private_key='{{ wireguard_server_privkey }}'
set network.wg0.listen_port='{{ wireguard_port }}'
add_list network.wg0.addresses='{{ wireguard_subnet }}.1/24'
add_list network.wg0.addresses='{{ wireguard_subnet6 }}::1/64'

{% for peer in wireguard_peers | default([]) %}
set network.wg_peer_{{ peer.name | replace('-', '_') }}=wireguard_wg0
set network.wg_peer_{{ peer.name | replace('-', '_') }}.description='{{ peer.name }}'
set network.wg_peer_{{ peer.name | replace('-', '_') }}.public_key='{{ peer.pubkey }}'
set network.wg_peer_{{ peer.name | replace('-', '_') }}.preshared_key='{{ peer.psk }}'
set network.wg_peer_{{ peer.name | replace('-', '_') }}.route_allowed_ips='1'
set network.wg_peer_{{ peer.name | replace('-', '_') }}.persistent_keepalive='25'
add_list network.wg_peer_{{ peer.name | replace('-', '_') }}.allowed_ips='{{ wireguard_subnet }}.{{ peer.ip_suffix }}/32'
add_list network.wg_peer_{{ peer.name | replace('-', '_') }}.allowed_ips='{{ wireguard_subnet6 }}::{{ peer.ip_suffix }}/128'
{% endfor %}

# Attach wg0 to the trusted LAN zone and allow UDP port on WAN
del_list firewall.zone_lan.network='wg0'
add_list firewall.zone_lan.network='wg0'

# Ensure dnsmasq listens on wg0 without serving DHCP (satisfies localservice=1)
delete dhcp.wg0
set dhcp.wg0=dhcp
set dhcp.wg0.interface='wg0'
set dhcp.wg0.ignore='1'

delete firewall.allow_wan_wireguard
set firewall.allow_wan_wireguard=rule
set firewall.allow_wan_wireguard.name='Allow-WireGuard'
set firewall.allow_wan_wireguard.src='wan'
set firewall.allow_wan_wireguard.proto='udp'
set firewall.allow_wan_wireguard.dest_port='{{ wireguard_port }}'
set firewall.allow_wan_wireguard.target='ACCEPT'
