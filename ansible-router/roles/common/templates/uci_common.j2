# --- System Configuration ---
set system.@system[0].hostname='{{ inventory_hostname }}'
set system.@system[0].zonename='Asia/Ho_Chi_Minh'
set system.@system[0].timezone='<-07>-7'

# --- Loopback & Globals ---
set network.loopback=interface
set network.loopback.device='lo'
set network.loopback.proto='static'
set network.loopback.ipaddr='127.0.0.1'
set network.loopback.netmask='255.0.0.0'

set network.globals=globals
set network.globals.ula_prefix='{{ ula_prefix }}'

# --- Main DSA VLAN-Filtering Bridge (br-lan) ---
set network.br_lan=device
set network.br_lan.name='br-lan'
set network.br_lan.type='bridge'
set network.br_lan.vlan_filtering='1'
{% set active_bridge_ports = lan_ports if 'core_routers' in group_names else all_ports %}
{% for port in active_bridge_ports %}
add_list network.br_lan.ports='{{ port }}'
{% endfor %}

# --- Per-Port 802.1Q Bridge VLAN Membership ---
{% set port_map = port_vlans | default({}) %}
{% for vlan in vlans %}
set network.vlan_{{ vlan.id }}=bridge-vlan
set network.vlan_{{ vlan.id }}.device='br-lan'
set network.vlan_{{ vlan.id }}.vlan='{{ vlan.id }}'
{% for port in active_bridge_ports %}
{% set p_cfg = port_map[port] if port in port_map else {'pvid': default_pvid_vlan | default(10), 'tagged': 'all'} %}
{% if p_cfg.pvid is defined and p_cfg.pvid == vlan.id %}
add_list network.vlan_{{ vlan.id }}.ports='{{ port }}:u*'
{% elif p_cfg.tagged is defined and (p_cfg.tagged == 'all' or (p_cfg.tagged is iterable and vlan.id in p_cfg.tagged)) %}
add_list network.vlan_{{ vlan.id }}.ports='{{ port }}:t'
{% endif %}
{% endfor %}
{% endfor %}
