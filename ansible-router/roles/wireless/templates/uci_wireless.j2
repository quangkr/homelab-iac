{% for radio_name, radio_cfg in (radios | default({})).items() %}
set wireless.{{ radio_name }}.country='{{ country_code }}'
set wireless.{{ radio_name }}.channel='{{ radio_cfg.channel }}'
set wireless.{{ radio_name }}.htmode='{{ radio_cfg.htmode }}'
set wireless.{{ radio_name }}.cell_density='0'
{% if wireless_enabled | default(true) %}
set wireless.{{ radio_name }}.disabled='0'
{% else %}
set wireless.{{ radio_name }}.disabled='1'
{% endif %}
{% endfor %}

{% if wireless_enabled | default(true) %}
{% for ssid_cfg in ssids | default([]) %}
{% for radio_name, radio_cfg in (radios | default({})).items() %}
{% if radio_cfg.band in ssid_cfg.band_ssids %}
{% set sec = 'wifinet_' ~ (ssid_cfg.id | replace('-', '_') | replace(' ', '_')) ~ '_' ~ radio_cfg.band %}
set wireless.{{ sec }}=wifi-iface
set wireless.{{ sec }}.device='{{ radio_name }}'
set wireless.{{ sec }}.mode='ap'
set wireless.{{ sec }}.ssid='{{ ssid_cfg.band_ssids[radio_cfg.band] }}'
set wireless.{{ sec }}.network='{{ ssid_cfg.network }}'
set wireless.{{ sec }}.encryption='{{ ssid_cfg.encryption }}'
{% if ssid_cfg.key is defined %}
set wireless.{{ sec }}.key='{{ ssid_cfg.key }}'
{% endif %}
set wireless.{{ sec }}.hidden='{{ 1 if ssid_cfg.hidden else 0 }}'
{% if ssid_cfg.encryption == 'sae-mixed' %}
# Required for WPA2/WPA3 mixed mode: 1 = optional (allows both WPA2 and WPA3 clients)
set wireless.{{ sec }}.ieee80211w='1'
{% elif ssid_cfg.encryption == 'sae' %}
# Required for pure WPA3: 2 = mandatory
set wireless.{{ sec }}.ieee80211w='2'
{% endif %}
{% if ssid_cfg.ieee80211r | default(false) %}
set wireless.{{ sec }}.ieee80211r='1'
set wireless.{{ sec }}.mobility_domain='{{ ssid_cfg.mobility_domain }}'
set wireless.{{ sec }}.ft_over_ds='0'
set wireless.{{ sec }}.ft_psk_generate_local='1'
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
