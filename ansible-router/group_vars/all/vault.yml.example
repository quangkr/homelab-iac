# vim: ft=yaml :
---
# PPPoE WAN Credentials
vault_pppoe_user: "PPPOE_USER"
vault_pppoe_pass: "PPPOE_PASS"

dhcp_static_leases:
  - name: "home-server"
    mac: "aa:bb:cc:dd:ee:01"
    ip: "192.168.10.10"
    # Optional: hex interface ID for stateful DHCPv6 (assigns <prefix>::10 to match ::10/-64 firewall rules)
    hostid: "10"
  - name: "nas"
    mac: "aa:bb:cc:dd:ee:02"
    ip: "192.168.10.20"
    hostid: "20"
  - name: "smart-tv"
    mac: "aa:bb:cc:dd:ee:03"
    ip: "192.168.30.50"
    hostid: "50"

dhcp_static_domains:
  - name: "jellyfin.example.com"
    ip: "192.168.20.10"
    # Optional: assign an internal ULA IPv6 address so local clients connect over IPv6 internally
    ip6: "fd00:1234:5678:20::10"
  - name: "ha.example.com"
    ip: "192.168.20.20"
    # Optional: set ip6 to "::" to return an empty NODATA response for AAAA queries,
    # preventing local clients from falling back to a public Cloudflare AAAA record
    ip6: "::"

ssids:
  - id: "main"
    band_ssids:
      2g: "MainWifi"
      5g: "MainWifi"
    network: "lan"
    encryption: "sae-mixed"
    ieee80211r: true
    mobility_domain: "4f57"
    hidden: true
    key: "CHANGE_ME_MAIN_PASS"

  - id: "lab"
    band_ssids:
      2g: "LabWifi-2G"
      5g: "LabWifi-5G"
    network: "lab"
    encryption: "sae-mixed"
    ieee80211r: true
    mobility_domain: "4f58"
    hidden: true
    key: "CHANGE_ME_LAB_PASS"

  - id: "guest"
    band_ssids:
      2g: "HomeWifi"
      5g: "HomeWifi"
    network: "guest"
    encryption: "sae-mixed"
    ieee80211r: true
    mobility_domain: "4f59"
    hidden: false
    key: "CHANGE_ME_GUEST_PASS"

  - id: "iot"
    band_ssids:
      2g: "IotWifi"
    network: "iot"
    encryption: "psk2+ccmp"
    ieee80211r: false
    hidden: true
    key: "CHANGE_ME_IOT_PASS"

  - id: "iot_pub"
    band_ssids:
      2g: "IotPubWifi"
    network: "iot_pub"
    encryption: "psk2+ccmp"
    ieee80211r: false
    hidden: true
    key: "CHANGE_ME_IOT_PUB_PASS"

port_forwards: 
  - name: "Lab_HTTP"
    proto: "tcp"
    src_dport: 80
    dest_zone: "lab"
    dest_ip: "192.168.20.2"
    # dest_port: 80           # same as src_dport if omitted
  - name: "Lab_HTTPS"
    proto: "tcp"
    src_dport: 443
    dest_zone: "lab"
    dest_ip: "192.168.20.2"
    dest_port: 443

ipv6_inbound_rules:
  - name: "Lab_HTTP_v6"
    proto: "tcp"
    dest_zone: "lab"
    # dest_ip: "::10/-64"     #  matches all host if omitted
    dest_port: "80"
  - name: "Lab_HTTPS_v6"
    proto: "tcp"
    dest_zone: "lab"
    dest_ip: "::10/-64"       # matches host suffix ::10 regardless of ISP /56 or /64 prefix
    dest_port: "443"

ddns_domains:
  - zone: "example.com"
    api_token: "CLOUDFLARE_API_TOKEN_1"
    ipv4: true
    ipv6: true
    subdomains:
      - name: "@"
      - name: "lab"
        ipv4: true
        ipv6: false
      - name: "vpn"
        ipv4: true
        ipv6: true

  - zone: "example.net"
    api_token: "CLOUDFLARE_API_TOKEN_2"
    ipv4: true
    ipv6: false
    subdomains:
      - name: "@"
      - name: "*.home"
        # Optional: concrete FQDN queried by ddns-scripts to check current public IP
        # (prevents NXDOMAIN every 5 minutes if bare "home.example.net" has no record)
        lookup_host: "ddns-check.home.example.net"
        ipv4: true
        ipv6: true

# Private IPv6 ULA Prefix Base
ula_base: "fd00:1234:5678"
